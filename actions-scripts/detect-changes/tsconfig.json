{
  "compilerOptions": {
    "target": "es2020",
    "strict": true,
    "sourceMap": false,
    "module":"nodenext",
    "moduleResolution":"nodenext",
    "esModuleInterop": true, 
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true, 
    "isolatedModules": true, 
    "types": [ "node" ],
    "rootDir": "./src", 
    "outDir": "./dist"
  },
  "exclude": ["node_modules", "**/*.test.ts"]
}
