{
  "compilerOptions": {
    "target": "es2020",
    "strict": true,
    "sourceMap": true,
    "module":"nodenext",
    "moduleResolution":"nodenext",
    "esModuleInterop": true, 
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true, 
    "types": [ "node" ],
    "rootDir": "./src", 
    "outDir": "./dist",
    "declaration": true
  },
  "exclude": ["node_modules", "**/*.test.ts", "dist"]
}