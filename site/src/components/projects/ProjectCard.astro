---
import Carousel from "../carousel/Carousel.astro";

const { project } = Astro.props;
---

<div class="bg-gray-100 w-100 rounded-base pt-3 px-2 pb-4">
    <h3 class="text-3xl underline text-center">{project.data.title}</h3>

    <Carousel id={project.data.title + '-carousel'} images={project.data.images} />

    <div class="flex columns-2 justify-between mx-5 mb-5">
        <p class="flex h-full items-start">{project.data.progress}</p>
        <p class="flex h-full items-end">{"ETA: " + project.data.expectedrelease}</p>
    </div>
    
    <p class="my-2">{project.body}</p>
</div>