<div>
    <h2 class="text-center text-3xl font-semibold">Manage Notifications</h2>

    <p class="mt-5">Subscribe to our newsletter to get notified whenever we publish a new devlog! You can always unsubscribe at any time from <a class="text-blue-500 underline" href="/unsubscribe">here</a>.</p>

    <form class="bg-gray-100 rounded-base p-5 w-100 mx-auto mt-10" id="subscribe-form">
        <label for="email">Email:</label><br>
        <input class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight bg-white focus:outline-none focus:shadow-outline" id="email" name="email" type="email">
        
        <br>
        <button class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline mt-10" type="submit">Subscribe</button>
        
        <br><p id="confirmation" class="text-green-500 mt-10 invisible">Sent. Check your Email for a verification before you can begin receiving Emails.</p>
    </form>

    <script>
        // https://developer.mozilla.org/en-US/docs/Learn_web_development/Extensions/Forms/Sending_forms_through_JavaScript
   
        async function sendData() {
            // Grab data from the form
            const email = document.getElementById("email");
            if (email == null || !(email instanceof HTMLInputElement)) {
                throw new Error("Couldn't find form email or input is invalid");
            }

            try {
                await fetch("https://api.sbox-soft.com/subscribe", {
                    method: "POST",
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        email: email.value
                    })
                });
            } catch (e) {
                console.error(e);
            }
        }

        async function showMessage() {
            const message = document.querySelector("#confirmation");
            message?.classList.remove("invisible");
        }

        // Override form submission
        const form = document.querySelector("#subscribe-form");
        form?.addEventListener("submit", (event) => {
            event.preventDefault(); // Stop page reload
            sendData();
            showMessage();
        });
    </script>
</div>