---
import { getCollection } from "astro:content";
import TeamMemberCard from "./TeamMemberCard.astro";

const members = await getCollection('teamMembers');
---

<div>
    <section class="my-10">
        <h2 class="text-center text-3xl font-semibold">About SBox-Soft</h2>
        <p class="my-5">SBox-Soft is an Australia based small scale game development team dedicated to maybe eventually delivering something.</p>
    </section>

    <section class="my-20">        
        <h2 class="text-center text-3xl font-semibold mb-10">Meet the Team!</h2>
        
        <div>
            {members.map((member) => (
                <TeamMemberCard member={member} />
            ))}
        </div>
    </section>
</div>