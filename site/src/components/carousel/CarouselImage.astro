---
import { Picture } from 'astro:assets';
const { imageUrl, alt } = Astro.props;
---

<div class="hidden ease-in-out" data-carousel-item>
    <Picture class="absolute block w-full h-full object-cover -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2" src={imageUrl} alt={alt} width="100" height="100"/>
</div>