---
import '../styles/global.css';
import fullLogo from '../assets/full-logo.png';
import { Picture } from 'astro:assets';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>SBox Software</title>
    </head>
    <body>
        <header>
            <nav class="mx-auto flex items-center justify-between px-5 py-2 bg-custom-blue">
                <div>
                    <h1 class="sr-only">SBox Software</h1>
                    <a href="/"><Picture src={fullLogo} alt="SBox Software Logo" formats={['avif', 'webp']} class="h-12 w-auto" height="500"/></a>
                </div>
                <div class="flex items-center space-x-10 text-white text-lg font-medium underline">
                    <a href="/projects">Projects</a>
                    <a href="/logs">Dev Logs</a>
                    <a href="/notifications">Notifications</a>
                    <a href="/about">About</a>
                </div>
            </nav>
        </header>
        <div class="mx-75 my-10">
            <slot />
        </div>
        <script is:inline src="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.js"></script>
    </body>
</html>
